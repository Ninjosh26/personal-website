# Azure SQL Database connection string (Prisma format)
DATABASE_URL="sqlserver://<server>.database.windows.net:1433;database=<dbname>;user=<user>;password=<password>;encrypt=true"

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID="<your-google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<your-google-oauth-client-secret>"

# OAuth callback URL - use http://localhost:3000/api/auth/callback for local dev
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/callback"

# Comma-separated list of authorized Google account email addresses
ALLOWED_GOOGLE_EMAILS="<email1>,<email2>,<email3>"

# Secret used to sign session cookies - use a long random string (min 32 chars)
SESSION_SECRET="replace-this-with-a-long-random-string-at-least-32-chars"

# Server port
PORT=3000

# Set to "production" on Azure App Service, leave unset or "development" locally
NODE_ENV="development"